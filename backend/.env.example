# 复制为 .env 后修改
DATABASE_URL=postgresql://postgres:admin123@127.0.0.1:5432/edge_box
DETECT_SERVER_URL=http://127.0.0.1:8080

# Windows 开发默认 onnx；RK3588 盒子改为 rknn
# ultralytics = 本机 .pt 调试（requirements.txt）
EDGE_INFERENCE=onnx
EDGE_PORT=8080

# RK3588 可选（见 deploy/BARE-METAL.md）
# RKNN_CORE_MASK=0_1_2
# RKNN_INPUT_UINT8=1
# EDGE_APP_VERSION=1.0.0
# EDGE_CJK_FONT=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
