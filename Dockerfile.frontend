# 构建 context = 上级目录（同时包含 yolo-demo 与 edge-ai-box）
FROM node:18-alpine AS build

WORKDIR /app

ARG VITE_DEPLOY_MODE=edge
ENV VITE_DEPLOY_MODE=${VITE_DEPLOY_MODE}

RUN npm config set registry https://registry.npmmirror.com

COPY yolo-demo/yolo-client/package*.json ./
RUN npm ci --production=false

COPY yolo-demo/yolo-client/ .
RUN npm run build:edge

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY edge-ai-box/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
